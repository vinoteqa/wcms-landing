DEMO_BOOKING_PAGE='https://www.example.com'
DEMO_BOOKING_PAGE_DE='https://www.example.com/de' # if empty, the default booking page will be used
DEMO_BOOKING_PAGE_EN='https://www.example.com/en' # if empty, the default booking page will be used
DEMO_BOOKING_PAGE_IT='https://www.example.com/it' # if empty, the default booking page will be used

HUBSPOT_PORTAL_ID='1234567890'
HUBSPOT_FORM_ID_DE='1234567890'
HUBSPOT_FORM_ID_EN='1234567890'
HUBSPOT_FORM_ID_IT='1234567890'

# Overwrites the `gtag.id` module option
NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX

# Nuxt Studio (production publishing)
# Variable names use the STUDIO_* prefix (what nuxt-studio@1.7 reads at runtime).
# See README.md for full setup instructions.
#
# --- GitHub OAuth (editors sign in with GitHub) ---
# Create a GitHub OAuth App at https://github.com/settings/developers
# - Application name: e.g. Vinoteqa Studio
# - Homepage URL: http://localhost:3000 (local) or https://www.vinoteqa.com (prod)
# - Authorization callback URL (exact path — note the double underscore):
#     http://localhost:3000/__nuxt_studio/auth/github
#     https://www.vinoteqa.com/__nuxt_studio/auth/github
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
#
# --- Google OAuth (editors sign in with Google) ---
# Create a Google OAuth client at https://console.cloud.google.com/apis/credentials
# - Application type: Web application
# - Authorized redirect URIs (exact path — note the double underscore):
#     http://localhost:3000/__nuxt_studio/auth/google
#     https://www.vinoteqa.com/__nuxt_studio/auth/google
# Google OAuth does not grant Git access — you also need STUDIO_GITHUB_TOKEN below.
# STUDIO_GOOGLE_MODERATORS is required: only listed emails can access Studio.
STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
STUDIO_GOOGLE_MODERATORS=editor@example.com,admin@example.com
# Optional: override redirect URI when behind a proxy or custom domain routing.
# STUDIO_GOOGLE_REDIRECT_URL=https://www.vinoteqa.com/__nuxt_studio/auth/google
#
# --- GitHub PAT (required when using Google OAuth) ---
# Fine-grained or classic token with write access to the content repository.
# Not needed when editors authenticate via GitHub OAuth (token is obtained at login).
STUDIO_GITHUB_TOKEN=

# Optional (build-time): override Nuxt Content SQLite path.
# Default is :memory: so Nix/read-only hosts work. Writable example:
# CONTENT_DATABASE_PATH=/tmp/wcms-landing-contents.sqlite
CONTENT_DATABASE_PATH=

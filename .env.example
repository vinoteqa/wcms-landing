DEMO_BOOKING_PAGE='https://www.example.com'
DEMO_BOOKING_PAGE_DE='https://www.example.com/de' # if empty, the default booking page will be used
DEMO_BOOKING_PAGE_EN='https://www.example.com/en' # if empty, the default booking page will be used
DEMO_BOOKING_PAGE_IT='https://www.example.com/it' # if empty, the default booking page will be used

HUBSPOT_PORTAL_ID='1234567890'
HUBSPOT_FORM_ID_DE='1234567890'
HUBSPOT_FORM_ID_EN='1234567890'
HUBSPOT_FORM_ID_IT='1234567890'

# Overwrites the `gtag.id` module option
NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX

# Nuxt Studio (production publishing via GitHub OAuth)
# Create a GitHub OAuth App at https://github.com/settings/developers
# - Application name: e.g. Vinoteqa Studio
# - Homepage URL: http://localhost:3000 (local) or https://www.vinoteqa.com (prod)
# - Authorization callback URL (exact path — note the double underscore):
#     http://localhost:3000/__nuxt_studio/auth/github
#     https://www.vinoteqa.com/__nuxt_studio/auth/github
# Copy Client ID and generate a Client Secret from the app settings.
# Variable names must match what nuxt-studio reads at build/preview time.
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
